#!/usr/bin/env bash
# Build a workspace in the sandbox's tmux from a layout directory, then attach
# with the editor open; C-a d leaves and the container ends. The directory
# holds layout.tsv, one pane a row, and the screen each pane shows. A copy of
# the host's own layout mounted at /mirror wins over the generic workspace.
# --detached seeds and exits.
set -euo pipefail

dir=/usr/local/share/tmux-tree-editor/workspace
if [[ -f /mirror/layout.tsv ]]; then
  dir=/mirror
fi
mkdir -p "$HOME"

declare -A last=() first=() layout=()
order=()
attach=""
while IFS= read -r line; do
  if [[ -z $line || $line == '#'* ]]; then
    continue
  fi
  # A tab is whitespace to read, which would merge an empty field into the
  # next, so each row is split on a separator read keeps.
  IFS=$'\x1f' read -r session key window window_layout title command path screen <<<"${line//$'\t'/$'\x1f'}"
  path=${path:-$HOME}
  mkdir -p "$path"
  run=(fake-pane "${command:-sh}" "$dir/$screen")
  if [[ -n ${last[$key]:-} ]]; then
    pane=$(tmux split-window -d -t "${last[$key]}" -c "$path" -P -F '#{pane_id}' "${run[@]}")
    tmux select-layout -t "$pane" tiled
  elif tmux has-session -t "=$session" 2>/dev/null; then
    pane=$(tmux new-window -d -t "=$session:" -n "$window" -c "$path" -P -F '#{pane_id}' "${run[@]}")
  else
    pane=$(tmux new-session -d -s "$session" -n "$window" -c "$path" -x 400 -y 100 -P -F '#{pane_id}' "${run[@]}")
    attach=${attach:-$session}
  fi
  if [[ -z ${first[$key]:-} ]]; then
    first[$key]=$pane
    order+=("$key")
  fi
  last[$key]=$pane
  layout[$key]=$window_layout
  if [[ -n $title ]]; then
    tmux select-pane -t "$pane" -T "$title"
  fi
done <"$dir/layout.tsv"

# A mirrored row carries its window's tmux layout, which puts every pane back
# at the size it had on the host.
for key in "${order[@]}"; do
  if [[ -n ${layout[$key]} ]]; then
    tmux select-layout -t "${first[$key]}" "${layout[$key]}" 2>/dev/null || true
  fi
done

if [[ ${1:-} == --detached ]]; then
  exit 0
fi
exec tmux attach -t "=$attach" \; display-popup -E -w 96% -h 94% tmux-tree-editor
